{
  "manifest_version": 3,
  "name": "Facebook Matcher22",
  "version": "1.0",
  "permissions": ["webNavigation", "activeTab", "scripting"],
  "host_permissions": [
"https://*://*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://m.facebook.com/*", "*://*.theguardian.com/*"],  
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
    "background": {
    "service_worker": "background.js"
  }
}
